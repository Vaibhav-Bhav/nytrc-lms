# Application
APP_ENV=development
APP_URL=http://localhost:3000

# Supabase
# Use the SERVICE ROLE key (not the anon key) for server-side repository access.
# Never expose this key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
# RAZORPAY_MODE: set to "test" for sandbox, "live" for production
# Never commit real credentials. Copy this file to .env and fill in values.
RAZORPAY_MODE=test
VITE_RAZORPAY_KEY_ID=rzp_test_your_actual_key_here
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend Transactional Email
# Server-only API key. Never expose to browser.
RESEND_API_KEY=
EMAIL_FROM=NYTRC LMS <onboarding@resend.dev>
SUPPORT_EMAIL=support@nytrc.org

# Statutory GST Seller Configuration
SELLER_NAME=NYTRC Educational Services
SELLER_GSTIN=27AAAAA0000A1Z5
SELLER_STATE=MAHARASHTRA
SAC_CODE=998439

# Bunny Stream
# Server-only credentials. Never expose to browser.
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_STREAM_HOSTNAME=video.bunnycdn.com
BUNNY_STREAM_TOKEN_KEY=

# Cloudflare R2
# S3-compatible configuration. Account ID and Bucket details.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
