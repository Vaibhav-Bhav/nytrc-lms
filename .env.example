# Application
APP_ENV=development
APP_URL=http://localhost:3000

# Razorpay
# RAZORPAY_MODE: set to "test" for sandbox, "live" for production
# Never commit real credentials. Copy this file to .env and fill in values.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Bunny Stream
# Never commit real API keys. Copy this file to .env and fill in values.
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_STREAM_HOSTNAME=video.bunnycdn.com

# Cloudflare R2
# S3-compatible configuration. Account ID and Bucket details.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
