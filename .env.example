# Application
APP_ENV=development
APP_URL=http://localhost:3000

# Razorpay
# RAZORPAY_MODE: set to "test" for sandbox, "live" for production
# Never commit real credentials. Copy this file to .env and fill in values.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
